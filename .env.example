# Copia este archivo a .env.local (desarrollo) o cárgalo en Vercel > Settings > Environment Variables.
# Todas son públicas (prefijo NEXT_PUBLIC_): terminan en el HTML del sitio.

# URL final del sitio, sin barra al final. Se usa para OG, sitemap y robots.
NEXT_PUBLIC_SITE_URL=https://screamlab.net

# WhatsApp: solo dígitos con código de país, sin "+". Ejemplo Chile: 569XXXXXXXX
NEXT_PUBLIC_WHATSAPP=56900000000

# Usuario de Instagram sin "@"
NEXT_PUBLIC_INSTAGRAM=screamlabnet

NEXT_PUBLIC_EMAIL=hola@screamlab.net
